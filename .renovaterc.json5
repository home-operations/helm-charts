{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>home-operations/renovate-config",
    // Bumps Chart.yaml appVersion from the upstream image tag via the
    // `# renovate: image=...` annotation above it.
    "customManagers:helmChartYamlAppVersions",
  ],
  packageRules: [
    // One grouped PR per chart: every dependency found under a chart directory
    // (the appVersion annotation, its vendir git ref, values.yaml images) lands
    // on one branch.
    {
      matchFileNames: ["charts/**"],
      groupName: "{{parentDir}} chart",
    },
    // The vendir git ref and the appVersion image tag track the same upstream
    // release from different datasources (git tags vs. the container registry),
    // and the image can lag the tag. Hold the branch until both resolve so the
    // crds task's ref==appVersion check stays green on Renovate PRs.
    {
      matchFileNames: ["charts/**/vendir.yml", "charts/**/Chart.yaml"],
      groupName: "{{parentDir}} upstream",
      minimumGroupSize: 2,
    },
    // Vendir refs are pinned git tags, so the lock sha never moves; the
    // monthly lock maintenance branch would only sit on the dashboard held by
    // the minimumGroupSize rule above.
    {
      matchManagers: ["vendir"],
      lockFileMaintenance: { enabled: false },
    },
  ],
}
