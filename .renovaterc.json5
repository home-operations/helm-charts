{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>home-operations/renovate-config",
    // Bumps Chart.yaml appVersion from the upstream image tag via the
    // `# renovate: image=...` annotation above it.
    "customManagers:helmChartYamlAppVersions",
  ],
  packageRules: [
    // One grouped PR per chart: every dependency found under a chart directory
    // (the appVersion annotation, its vendir git ref, values.yaml images) lands
    // on one branch. Grouping appVersion with the vendir ref also keeps the
    // crds task's ref==appVersion check green on Renovate PRs.
    {
      matchFileNames: ["charts/**"],
      groupName: "{{parentDir}} chart",
    },
  ],
}
