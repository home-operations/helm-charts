{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "affinity": {
      "description": "Affinity rules for pod scheduling.",
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "controller": {
      "description": "Controller runtime configuration.",
      "properties": {
        "extraArgs": {
          "description": "Additional arguments passed to the controller (e.g. \"--retry-crd-interval-max=30s\").",
          "items": {
            "required": []
          },
          "title": "extraArgs",
          "type": "array"
        },
        "leaderElection": {
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable leader election (required to run more than one replica). The default\nprobes hit /healthz/leader-election, which only exists while leader election\nis on; override livenessProbe/readinessProbe when disabling this.",
              "title": "enabled",
              "type": "boolean"
            }
          },
          "required": [],
          "title": "leaderElection",
          "type": "object"
        },
        "metrics": {
          "properties": {
            "annotations": {
              "description": "Annotations for the metrics Service.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "port": {
              "default": 8080,
              "description": "Operational port: /metrics plus the leader-election health check (plain\nHTTP; always on; restrict with a NetworkPolicy rather than disabling).",
              "title": "port",
              "type": "integer"
            }
          },
          "required": [],
          "title": "metrics",
          "type": "object"
        },
        "verbosity": {
          "default": 2,
          "description": "Log verbosity (klog --v level).",
          "title": "verbosity",
          "type": "integer"
        },
        "volumeGroupSnapshots": {
          "default": true,
          "description": "Enable the CSIVolumeGroupSnapshot feature gate (VolumeGroupSnapshot support).",
          "title": "volumeGroupSnapshots",
          "type": "boolean"
        }
      },
      "required": [],
      "title": "controller",
      "type": "object"
    },
    "env": {
      "description": "Extra environment variables passed to the container.",
      "items": {
        "required": []
      },
      "title": "env",
      "type": "array"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Override the full release name.",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "image": {
      "properties": {
        "pullPolicy": {
          "default": "IfNotPresent",
          "description": "Image pull policy.",
          "title": "pullPolicy",
          "type": "string"
        },
        "repository": {
          "default": "registry.k8s.io/sig-storage/snapshot-controller",
          "description": "Image repository.",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "",
          "description": "Overrides the image tag; defaults to the chart appVersion.",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for private registries.",
      "items": {
        "required": []
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "livenessProbe": {
      "description": "Liveness probe.",
      "properties": {
        "httpGet": {
          "properties": {
            "path": {
              "default": "/healthz/leader-election",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "metrics",
              "title": "port",
              "type": "string"
            }
          },
          "required": [],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 10,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 20,
          "title": "periodSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "livenessProbe",
      "type": "object"
    },
    "monitoring": {
      "properties": {
        "serviceMonitor": {
          "properties": {
            "annotations": {
              "description": "ServiceMonitor annotations.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Create a Prometheus Operator ServiceMonitor (requires its CRDs).",
              "title": "enabled",
              "type": "boolean"
            },
            "interval": {
              "default": "30s",
              "description": "Scrape interval.",
              "title": "interval",
              "type": "string"
            },
            "labels": {
              "description": "ServiceMonitor labels.",
              "required": [],
              "title": "labels",
              "type": "object"
            },
            "metricRelabelings": {
              "description": "Prometheus metric relabelings.",
              "items": {
                "required": []
              },
              "title": "metricRelabelings",
              "type": "array"
            },
            "path": {
              "default": "/metrics",
              "description": "Metrics path.",
              "title": "path",
              "type": "string"
            },
            "podTargetLabels": {
              "description": "Pod target labels to copy from pods.",
              "items": {
                "required": []
              },
              "title": "podTargetLabels",
              "type": "array"
            },
            "relabelings": {
              "description": "Prometheus relabelings (applied before scraping).",
              "items": {
                "required": []
              },
              "title": "relabelings",
              "type": "array"
            },
            "scrapeTimeout": {
              "default": "10s",
              "description": "Scrape timeout.",
              "title": "scrapeTimeout",
              "type": "string"
            },
            "targetLabels": {
              "description": "Target labels to copy from the Service.",
              "items": {
                "required": []
              },
              "title": "targetLabels",
              "type": "array"
            }
          },
          "required": [],
          "title": "serviceMonitor",
          "type": "object"
        }
      },
      "required": [],
      "title": "monitoring",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "Override the chart name used in resource names.",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "description": "Node selector for pod scheduling.",
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "podAnnotations": {
      "description": "Annotations added to the pod.",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podDisruptionBudget": {
      "description": "PodDisruptionBudget spec (e.g. `maxUnavailable: 1`); rendered when non-empty.",
      "required": [],
      "title": "podDisruptionBudget",
      "type": "object"
    },
    "podLabels": {
      "description": "Labels added to the pod.",
      "required": [],
      "title": "podLabels",
      "type": "object"
    },
    "podSecurityContext": {
      "description": "Pod-level securityContext (runs as non-root uid/gid 65532).",
      "properties": {
        "fsGroup": {
          "default": 65532,
          "title": "fsGroup",
          "type": "integer"
        },
        "runAsGroup": {
          "default": 65532,
          "title": "runAsGroup",
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "runAsUser": {
          "default": 65532,
          "title": "runAsUser",
          "type": "integer"
        },
        "seccompProfile": {
          "description": "Required by the PodSecurity \"restricted\" profile (org chart standard).",
          "properties": {
            "type": {
              "default": "RuntimeDefault",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "seccompProfile",
          "type": "object"
        }
      },
      "required": [],
      "title": "podSecurityContext",
      "type": "object"
    },
    "priorityClassName": {
      "default": "system-cluster-critical",
      "description": "Priority class name for pod scheduling (cluster infrastructure: keep it\nschedulable ahead of ordinary workloads).",
      "title": "priorityClassName",
      "type": "string"
    },
    "rbac": {
      "properties": {
        "annotations": {
          "description": "Annotations for the RBAC resources.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "create": {
          "default": true,
          "description": "Create the ClusterRole/ClusterRoleBinding and leader-election Role/RoleBinding\n(rules mirror the upstream rbac-snapshot-controller.yaml).",
          "title": "create",
          "type": "boolean"
        }
      },
      "required": [],
      "title": "rbac",
      "type": "object"
    },
    "readinessProbe": {
      "description": "Readiness probe.",
      "properties": {
        "httpGet": {
          "properties": {
            "path": {
              "default": "/healthz/leader-election",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "metrics",
              "title": "port",
              "type": "string"
            }
          },
          "required": [],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 5,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 10,
          "title": "periodSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "readinessProbe",
      "type": "object"
    },
    "replicaCount": {
      "default": 1,
      "description": "Number of controller replicas; leader election picks the active instance.",
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "description": "Pod resource requests/limits.",
      "required": [],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "description": "Container securityContext (no privilege escalation, read-only root filesystem, drops ALL capabilities).",
      "properties": {
        "allowPrivilegeEscalation": {
          "default": false,
          "title": "allowPrivilegeEscalation",
          "type": "boolean"
        },
        "capabilities": {
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "drop",
              "type": "array"
            }
          },
          "required": [],
          "title": "capabilities",
          "type": "object"
        },
        "readOnlyRootFilesystem": {
          "default": true,
          "title": "readOnlyRootFilesystem",
          "type": "boolean"
        },
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "runAsUser": {
          "default": 65532,
          "title": "runAsUser",
          "type": "integer"
        }
      },
      "required": [],
      "title": "securityContext",
      "type": "object"
    },
    "serviceAccount": {
      "properties": {
        "annotations": {
          "description": "Annotations for the ServiceAccount (e.g. workload-identity bindings).",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "automount": {
          "default": true,
          "description": "Automount the API token (on by default: the controller talks to the cluster API).",
          "title": "automount",
          "type": "boolean"
        },
        "create": {
          "default": true,
          "description": "Create a ServiceAccount.",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "ServiceAccount name; generated from the release name if empty.",
          "title": "name",
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    },
    "tolerations": {
      "description": "Tolerations for pod scheduling.",
      "items": {
        "required": []
      },
      "title": "tolerations",
      "type": "array"
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints for the pods.",
      "items": {
        "required": []
      },
      "title": "topologySpreadConstraints",
      "type": "array"
    },
    "volumeGroupSnapshotClasses": {
      "description": "VolumeGroupSnapshotClasses to create (same shape as volumeSnapshotClasses;\nrequires controller.volumeGroupSnapshots).",
      "items": {
        "required": []
      },
      "title": "volumeGroupSnapshotClasses",
      "type": "array"
    },
    "volumeSnapshotClasses": {
      "description": "VolumeSnapshotClasses to create (each entry: name, driver, deletionPolicy, and\noptional annotations, labels, parameters).",
      "items": {
        "required": []
      },
      "title": "volumeSnapshotClasses",
      "type": "array"
    }
  },
  "required": [],
  "type": "object"
}
